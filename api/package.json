{
  "name": "dutch-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "gen-meta": "node scripts/gen-meta.mjs",
    "db:local": "wrangler d1 execute dutch --local --file schema.sql",
    "db:remote": "wrangler d1 execute dutch --remote --file schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
